# The only required setting. Server-side only; never sent to the browser.
GEMINI_API_KEY=

# Optional: which Gemini model extracts (default in app/config.py)
# LLM_MODEL=gemini-3.5-flash

# live    = always call the API, refresh the cache
# cached  = use data/llm_cache/<file sha256>.json if present, else call the API (default)
# offline = cache only; a file with no cached response fails extraction, no network call
LLM_CACHE_MODE=cached

# Optional: extraction tuning (defaults in app/config.py)
# LLM_THINKING_LEVEL=LOW
# LLM_TIMEOUT_SECONDS=180

# Optional: pin "today" for the date rules, so a recorded demo decides the same way next month
# INVOICE_AS_OF_DATE=2026-11-16

# Optional: path to tesseract if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
